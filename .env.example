# Copy to .env.local and fill in. Never commit .env.local.

# Supabase: Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Apify: Console -> Settings -> API & Integrations
APIFY_API_TOKEN=your_apify_token_here
APIFY_INSTAGRAM_SCRAPER_ACTOR_ID=apify/instagram-scraper

# Anthropic: console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: secret used to encrypt API keys saved in Settings. If empty, it is derived from the Supabase service-role key.
# Set it once and never change it (changing it makes saved keys unreadable).
APP_ENCRYPTION_KEY=
